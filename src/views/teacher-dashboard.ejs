<%- include('partials-header') %>

<div class="actions">
  <a href="/teacher/attendance" class="btn btn-secondary">View Attendance History</a>
</div>

<div class="grid two">
  <section class="card">
    <h2>Add Student</h2>
    <% if (error) { %>
    <p class="error"><%= error %></p>
    <% } %>
    <form method="POST" action="/teacher/students">
      <label>Student ID</label>
      <input type="text" name="studentId" required />

      <label>Student Name</label>
      <input type="text" name="name" required />

      <label>Class</label>
      <input type="text" name="className" required />

      <label>Email (optional)</label>
      <input type="email" name="email" />

      <button class="btn" type="submit">Add Student</button>
    </form>
  </section>

  <section class="card">
    <h2>Students</h2>
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Class</th>
          <th>Email</th>
          <th>Attendance</th>
          <th>Delete</th>
        </tr>
      </thead>
      <tbody>
        <% if (!students.length) { %>
        <tr>
          <td colspan="6">No students found.</td>
        </tr>
        <% } %>
        <% students.forEach((student) => { %>
        <tr>
          <td><%= student.studentId %></td>
          <td><%= student.name %></td>
          <td><%= student.className %></td>
          <td><%= student.email || '-' %></td>
          <td>
            <form method="POST" action="/teacher/students/<%= student._id %>/attendance" class="inline-form">
              <select name="status" required>
                <option value="Present">Present</option>
                <option value="Absent">Absent</option>
              </select>
              <input type="date" name="date" />
              <button class="btn btn-small" type="submit">Mark</button>
            </form>
          </td>
          <td>
            <form method="POST" action="/teacher/students/<%= student._id %>/delete" onsubmit="return confirm('Delete this student?')">
              <button class="btn btn-danger" type="submit">Delete</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
</div>

<%- include('partials-footer') %>
